# Phase Z: OS-Agnostic Core Installation & Hypervisor Provisioning
Write-Host "Evaluating Operating System environment..." -ForegroundColor Cyan

$OSInfo = Get-CimInstance -ClassName Win32_OperatingSystem

if ($OSInfo.ProductType -eq 1) {
    # ProductType 1 = Windows Desktop (10/11)
    Write-Host "Detected Windows Client OS ($($OSInfo.Caption)). Initializing DISM deployment..." -ForegroundColor Green
    
    Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -All -NoRestart
    
    Write-Host "Hyper-V Client binaries installed successfully." -ForegroundColor Green
} 
else {
    # ProductType 2 or 3 = Windows Server (Domain Controller / Standalone)
    Write-Host "Detected Windows Server OS ($($OSInfo.Caption)). Initializing Server Manager deployment..." -ForegroundColor Green
    
    Install-WindowsFeature -Name Hyper-V -IncludeManagementTools
    
    Write-Host "Hyper-V Server role installed successfully." -ForegroundColor Green
}

# Prompt or enforce system reboot to lock in hypervisor kernel extensions
Write-Host "[ACTION REQUIRED] Hypervisor driver initialization requires a system reboot." -ForegroundColor Yellow
# Restart-Computer -Force
